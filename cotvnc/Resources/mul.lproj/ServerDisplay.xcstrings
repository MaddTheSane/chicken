          "stringUnit" : {
            "state" : "new",
            "value" : "Store this password in your Keychain for automatic retrieval next time."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrer ce mot de passe dans le trousseau pour le récupérer automatiquement la prochaine fois"
