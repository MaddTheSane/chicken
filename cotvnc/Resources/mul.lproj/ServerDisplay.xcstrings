    "98.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Keyboard and mouse events will not be sent to the server, you will only be observing.\"; ObjectID = \"98\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Keyboard and mouse events will not be sent to the server, you will only be observing."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les actions clavier et souris ne seront pas transmises. Vous allez simplement observer"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli eventi tastiera e mouse non verranno mandati al server, osserverai solamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーボードおよびマウスを操作してもサーバに送信しません。サーバの監視のみを行います。"
          }
        }
      }
    },
