    "20.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Store this password in your Keychain for automatic retrieval next time.\"; ObjectID = \"20\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
