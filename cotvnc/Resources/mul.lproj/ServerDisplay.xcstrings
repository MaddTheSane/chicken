    "7.ibShadowedToolTip" : {
      "comment" : "Class = \"NSTextField\"; ibShadowedToolTip = \"The password for the server to which you wish to connect\"; ObjectID = \"7\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The password for the server to which you wish to connect"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mot de passe du serveur auquel vous souhaitez vous connecter"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La parola d'accesso per il server a cui desideri connetterti"
          }
        },
