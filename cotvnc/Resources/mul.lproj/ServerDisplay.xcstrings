    "26.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Other clients can connect to the server at the same time as you.\"; ObjectID = \"26\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Other clients can connect to the server at the same time as you."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D'autres clients peuvent se connecter au serveur en même temps que vous"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altri clienti possono connettersi al server allo stesso tempo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用中にほかのクライアントがサーバへ接続できるようにします。"
          }
        }
      }
    },
    "92.ibShadowedToolTip" : {
