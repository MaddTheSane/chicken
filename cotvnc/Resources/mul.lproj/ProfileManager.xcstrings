      "comment" : "Class = \"NSTextFieldCell\"; title = \"You can increase responsiveness by using a lower color resolution, since less data needs to be transmitted.\"; ObjectID = \"552\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can increase responsiveness by using a lower color resolution, since less data needs to be transmitted."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez augmenter la réactivité en diminuant le nombre de couleurs, moins de données devant être transmises."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi Incrementare la risposta delle tue azioni \nusando una bassa risoluzione/numero di colori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "より低い色解像度を指定するほどレスポンスは向上します。\nこれは必要な転送データ量が少なくなるためです。"
          }
        }
      }
    },
