    "541.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"Drag encodings to change the preferred order.\\nUse the checkbox to disable specific encodings.\"; ObjectID = \"541\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Drag encodings to change the preferred order.\nUse the checkbox to disable specific encodings."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser les encodages pour modifier l'ordre de préférence. Utiliser la case à cocher pour désactiver des encodages spécifiques."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina le codifiche per spostarle in ordine preferito.\nVista i rettangoli per abilitare/disabilitare singole codifiche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エンコーディングをドラッグすると優先順位を変更できます。\nチェックボックスで使用するエンコーディングを指定します。"
          }
        }
      }
    },
